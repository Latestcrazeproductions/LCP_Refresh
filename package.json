    "@supabase/supabase-js": "^2.98.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^15.1.0",
    "nodemailer": "^6.10.1",
    "react": "^19.0.0",
