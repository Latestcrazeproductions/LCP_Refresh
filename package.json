    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.12",
