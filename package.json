{
  "name": "latest-craze-productions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port=3000 --hostname=0.0.0.0",
    "dev:3002": "next dev --port=3002 --hostname=127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sync-contacts": "node scripts/sync-lasso-contacts.mjs",
    "generate:seo-matrix": "node scripts/generate-seo-page-matrix.mjs",
    "seed-registry": "node scripts/seed-registry.mjs",
    "seo:dry-run": "npm run seo:run --prefix scripts/seo-orchestrator -- --cadence daily --dry-run",
    "seo:dry-run:weekly": "npm run seo:run --prefix scripts/seo-orchestrator -- --cadence weekly --dry-run",
    "seo:dry-run:monthly": "npm run seo:run --prefix scripts/seo-orchestrator -- --cadence monthly --dry-run",
    "seo:topic-stats": "npm run topic-stats --prefix scripts/seo-orchestrator",
    "seo:live": "npm run seo:run --prefix scripts/seo-orchestrator -- --cadence daily --max-tasks 5 --advance-rotation",
    "seo:test": "npm test --prefix scripts/seo-orchestrator",
